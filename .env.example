# Local Compose reads this file through explicit per-service allowlists in
# docker-compose.yml. Do not reintroduce a broad env_file mount: it would give
# low-privilege workers model, notification, or provider secrets they cannot use.
CONTROL_DATABASE_URL=postgres://openreview:openreview@postgres:5432/openreview?sslmode=disable

# Optional scoped API image pin for an already-validated local rollout. Leave
# empty for the normal shared core image; do not point all workers at an API-
# only image through OPEN_REVIEW_CORE_IMAGE.
OPEN_REVIEW_CONTROL_API_IMAGE=
# Optional scoped Console image pin for a verified local rollout. Leave empty
# to build the default local image with `docker compose build console`.
OPEN_REVIEW_CONSOLE_IMAGE=

# control-api: bind only to a private network in production; TLS terminates at the ingress.
HTTP_ADDRESS=:8080
ENVIRONMENT=development

# Casdoor OIDC. AUTH_MODE=development is permitted only with ENVIRONMENT=development.
AUTH_MODE=development
CASDOOR_ISSUER=https://casdoor.example.com
CASDOOR_AUDIENCE=open-review-platform

# Browser console OIDC/session bridge and the public origin rendered in
# GitHub/GitLab review comments. Do not use a private Docker service URL: the
# link is opened by the provider user in their browser.
# CASDOOR_CLIENT_ID may be the same client/audience when your Casdoor
# configuration uses a single public client.
# The GitHub state secret is web-only, must be 32+ characters, and must be
# different from every provider webhook secret and GitHub App private key.
OPEN_REVIEW_APP_URL=https://review.example.com
# Optional public /v1 API origin for CLI quickstart examples; defaults to
# OPEN_REVIEW_APP_URL. Do not point this at the private control-api service.
OPEN_REVIEW_PUBLIC_API_URL=
CASDOOR_CLIENT_ID=open-review-platform
CASDOOR_CLIENT_SECRET=
OPEN_REVIEW_DEPLOYMENT_MODE=self_hosted
OPEN_REVIEW_DEPLOYMENT_REGION=ap-southeast-1
GITHUB_APP_INSTALL_URL=
OPEN_REVIEW_GITHUB_INSTALL_STATE_SECRET=
# GitHub App user authorization validates that the returning administrator can
# access the installation before it is attached to a workspace. Register the
# exact redirect URI /api/setup/github/authorize/complete in the App and keep
# this secret only in the Console runtime secret manager.
WEB_OAUTH_GITHUB_CLIENT_ID=
WEB_OAUTH_GITHUB_CLIENT_SECRET=
# Required to bind an existing GitHub App installation through user OAuth.
GITHUB_APP_ID=
# GITHUB_OAUTH_CLIENT_* and GITHUB_APP_CLIENT_* are accepted aliases for
# existing deployments; use WEB_OAUTH_GITHUB_CLIENT_* for new installations.
GITHUB_OAUTH_BASE_URL=https://github.com
# Shared signed authorization receipt secret for GitHub App and GitLab OAuth.
# Keep this 32+ characters and distinct from provider webhook secrets. Configure
# the exact same value on both Console and control-api; the control-api verifies
# it before accepting a provider installation.
OPEN_REVIEW_PROVIDER_AUTH_STATE_SECRET=
# Optional but recommended stable 32+ character key for GitLab's opaque
# workspace-and-repository-scope installation identities. Set before rotating
# the state secret, and configure the same value on Console and control-api.
# When absent, OPEN_REVIEW_PROVIDER_AUTH_STATE_SECRET is used for compatibility.
OPEN_REVIEW_GITLAB_INSTALLATION_IDENTITY_SECRET=

# One secret per provider. Rotate through the provider UI, then update the runtime secret.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# GitHub App credentials are mounted as a read-only PEM file. Set
# GITHUB_APP_PRIVATE_KEY_HOST_PATH for Docker Compose; workers see it only at
# /run/secrets/github-app.pem. Existing local host paths in
# GITHUB_APP_PRIVATE_KEY_PATH remain compatible. An installation with
# credential_ref=`github-app` exchanges an app JWT for every provider call.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_HOST_PATH=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_API_URL=https://api.github.com
# Provider endpoints are deployment-owned trust boundaries. To connect a
# self-managed GitLab, set this to its exact HTTPS API base (for example
# https://gitlab.internal.example/api/v4), mount its credential on workers,
# and keep provider probing within the intended network policy. The Console
# shows this profile read-only; it never accepts a browser-supplied endpoint.
GITLAB_API_URL=https://gitlab.com/api/v4
# HTTPS is mandatory in production. This may be true only for a disposable,
# isolated development GitLab with no production credentials.
GITLAB_ALLOW_HTTP=false
# Optional browser origins for navigation links in Issue-triage comments.
# Each public base applies only to the exact paired provider API base. Without
# a pair, HTTPS self-managed links use the API host and may be unreachable
# from a browser; internal HTTP GitLab links are omitted. HTTP public GitLab
# is allowed only for loopback development.
ISSUE_TRIAGE_GITHUB_PUBLIC_BASE_URL=
ISSUE_TRIAGE_GITHUB_PUBLIC_FOR_API_BASE_URL=
ISSUE_TRIAGE_GITLAB_PUBLIC_BASE_URL=
ISSUE_TRIAGE_GITLAB_PUBLIC_FOR_API_BASE_URL=
# GitLab OAuth authorization-code exchange is performed by the web server,
# never by browser JavaScript. Provider-call workers receive the same client
# credentials only to refresh an expiring encrypted OAuth credential.
# For self-managed GitLab, set GITLAB_OAUTH_BASE_URL to its HTTPS base when it
# differs from the API-derived base. Relative URL installations are supported:
# https://gitlab.internal.example/gitlab remains under /gitlab for OAuth and API.
GITLAB_OAUTH_BASE_URL=
# Optional private base used only for server-side OAuth token exchange, identity
# lookup, and refresh when the browser-reachable origin cannot resolve inside
# the Console/worker network (for example local Docker GitLab).
GITLAB_OAUTH_INTERNAL_BASE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# `api` is required to publish review comments. The callback and any token
# refresh are server-side only; no browser form receives a token.
GITLAB_OAUTH_SCOPES=api read_user
# Base64-encoded 32-byte key used only to envelope GitLab OAuth credentials at
# rest. Production should inject it through a KMS/Vault-managed secret.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Durable event transport. PostgreSQL outbox rows are authoritative; this
# broker only receives relay notifications and can be rebuilt after downtime.
RABBITMQ_URL=amqp://openreview:openreview@localhost:5672/
RABBITMQ_EXCHANGE=openreview.events
OUTBOX_RELAY_ID=relay-1

# runner: install this exact OpenCodeReview release in the runner image.
OCR_BINARY=ocr
OCR_VERSION=1.12.5
# OCR range reviews require Git 2.41 or later. Set an absolute path when the
# system git is older, for example: /opt/homebrew/bin/git
GIT_BINARY=git
OCR_CONCURRENCY=2
# The CLI defaults to medium effort if this is unset. Low effort plus a
# risk-focused scope is the recommended starting point for DeepSeek flash-class
# gateways; calibrate it with a representative repository before tightening a
# merge gate.
OCR_REVIEW_EFFORT=low
# Per-group prompt input ceiling. 0 leaves the OCR template default intact.
OCR_MAX_PROMPT_TOKENS=8000
# Aggregate input + output budget for one review. Do not set below the CLI's
# estimate for a selected group, or OCR will correctly return an incomplete run.
OCR_MAX_TOKENS_BUDGET=128000
# OCR's per-subtask deadline in minutes. It is also the platform's hard
# process cap when lower than OCR_TIMEOUT, so a stuck CLI wrapper cannot keep
# consuming model capacity after its requested subtask deadline.
OCR_SUBTASK_TIMEOUT_MINUTES=5
# standard scans all source code; focused scans likely business/security impact
# first; critical keeps only the highest-risk changes for emergency workflows.
RISK_REVIEW_MODE=focused
# A completed AI review fails the stable GitHub Check when it finds an issue at
# or above this severity. Use `off` for advisory-only operation. Configure the
# Check as required in GitHub branch protection to enforce the merge gate.
MERGE_GATE_MIN_SEVERITY=critical
# Whole checkout deadline. This bounds clone/fetch network stalls before OCR.
CHECKOUT_TIMEOUT=2m
# A stopped worker is recoverable after this lease expires; live workers renew
# it before expiry throughout checkout and model execution.
RUNNER_LEASE_DURATION=2m
RUNNER_LEASE_RENEW_INTERVAL=30s
# Whole OCR process deadline. This bounds provider calls that do not honor the
# OCR CLI's per-task --timeout setting.
OCR_TIMEOUT=15m
RUNNER_ID=runner-1
RUNNER_POLL_INTERVAL=5s
# Deployment release identifier reported by durable worker heartbeats. Set this
# to an image digest, Git SHA, or immutable release version in production.
OPEN_REVIEW_BUILD_VERSION=development
NOTIFIER_WORKER_ID=notifier-1
# Development compact mode only. Default false retains notifications in the
# queue until a standalone notifier starts; production uses that split worker.
OPEN_REVIEW_COMPACT_NOTIFICATIONS=false
# Development compact mode only. Requires DATA_GOVERNANCE_ARTIFACT_KEY and
# deliberately starts a worker that can execute approved export/deletion jobs.
# Production keeps this worker and its key in a separate container.
OPEN_REVIEW_COMPACT_DATA_GOVERNANCE=false
# Development compact mode only. Opts in the provider-read-only Agent source
# worker; requires AGENT_DECISION_JEV_API_KEY. It does not enable Issue auto
# admission, coding, or Draft PR creation. Production uses the split worker.
OPEN_REVIEW_COMPACT_AGENT_SOURCE=false
SSO_PROBER_WORKER_ID=sso-prober-1
PROVIDER_PROBER_WORKER_ID=provider-prober-1
PROVIDER_FEEDBACK_POLLER_WORKER_ID=provider-feedback-poller-1
MODEL_PROBER_WORKER_ID=model-prober-1
DATA_GOVERNANCE_WORKER_ID=data-governance-worker-1
# One-shot scheduled re-admissions are claimed transactionally by this worker.
# A schedule is not queued work until this worker reaches its due timestamp.
REVIEW_SCHEDULER_WORKER_ID=review-scheduler-1
REVIEW_SCHEDULER_POLL_INTERVAL=1s
# Agent task approval creates a durable execution request. The runner turns it
# into a leased, auditable attempt but stops at needs_attention unless a
# separately isolated coding-agent adapter is deployed. It never executes
# Codex/Claude from this Compose worker or passes provider credentials to it.
AGENT_TASK_RUNNER_ID=agent-task-runner-1
# Provider-read-only worker that freezes the default branch and exact commit
# before an Agent plan may be created. It needs the same deployment-owned
# provider credentials as interaction-admitter, never an adapter secret.
AGENT_TASK_SOURCE_ADMITTER_WORKER_ID=agent-task-source-admitter-1
# The repository policy selects a backend; only this trusted worker owns its
# endpoint and credentials. Jev is the default for newly created policies.
AGENT_DECISION_JEV_URL=https://api.typesafe.ai/v1/systemone
AGENT_DECISION_JEV_API_KEY=
AGENT_DECISION_JEV_MODEL=jev-latest
# Optional fixed HTTPS chat-completions planner for workflow-enabled NEW tasks.
# Blank values use a source-derived structured plan; execution still needs
# exact owner/admin plan approval and an independent verification profile.
AGENT_PLANNER_API_BASE_URL=
AGENT_PLANNER_API_KEY=
AGENT_PLANNER_MODEL=
AGENT_TASK_LEASE_DURATION=2m
# Detects adapters that stop heartbeating. Expiry becomes needs_attention and
# sends an idempotent remote-stop request; it never retries code execution.
AGENT_TASK_REAPER_INTERVAL=15s
# The adapter POST endpoint and the public control-plane callback URL. Both
# default to HTTPS; development HTTP requires explicit opt-in. The shared
# secret signs runner submissions and adapter callbacks, and must be 32+ chars.
AGENT_TASK_ADAPTER_URL=
AGENT_TASK_CALLBACK_URL=https://review.example.com/v1/agent-adapter/events
AGENT_TASK_ADAPTER_SECRET=
AGENT_TASK_ADAPTER_TIMEOUT=15s
AGENT_TASK_ADAPTER_ALLOW_HTTP=false
# Optional development-only adapter profile (`docker compose --profile agent-adapter up`).
# ENVIRONMENT=development alone does not activate a coding CLI. This explicit
# opt-in acknowledges that the current UID pool is not a per-job container.
AGENT_ADAPTER_ALLOW_UNSANDBOXED_DEVELOPMENT=false
AGENT_ADAPTER_EXECUTOR_IDENTITY_POOL_SIZE=8
# Build a reviewed derivative image containing exactly one pinned Codex or
# Claude binary; its value must match the executor_profile frozen by each
# repository policy. Both profiles require a task-scoped model broker.
# This repository intentionally does not download a mutable CLI.
# The optional per-job Docker profile requires a dedicated Docker host, an
# internal-only sandbox network and a reviewed, immutable CLI image ID.
AGENT_ADAPTER_EXECUTOR=
AGENT_ADAPTER_SANDBOX_KIND=
AGENT_ADAPTER_DOCKER_BINARY=docker
AGENT_ADAPTER_SANDBOX_IMAGE_ID=
AGENT_ADAPTER_SANDBOX_NETWORK=open-review-platform_agent-sandbox
AGENT_ADAPTER_SANDBOX_WORKSPACE_VOLUME=open-review-platform_agent-adapter-workspaces
AGENT_ADAPTER_RECEIPT_DIR=/state
AGENT_ADAPTER_CODEX_BINARY=codex
AGENT_ADAPTER_CLAUDE_BINARY=claude
# Separate from AGENT_DECISION_JEV_API_KEY. The coding CLI gets only a short-
# lived local capability; this upstream key stays with the adapter process.
# The endpoint must support the OpenAI Responses API over HTTPS.
AGENT_ADAPTER_CODEX_MODEL_API_BASE_URL=
AGENT_ADAPTER_CODEX_MODEL_API_KEY=
AGENT_ADAPTER_CODEX_MODEL=
# Claude profile: Anthropic Messages-compatible HTTPS endpoint ending in /v1.
# Example: https://gateway.example.com/authropic/v1. The upstream key stays in
# the adapter; the isolated Claude CLI receives only a per-job capability.
AGENT_ADAPTER_CLAUDE_MODEL_API_BASE_URL=
AGENT_ADAPTER_CLAUDE_MODEL_API_KEY=
AGENT_ADAPTER_CLAUDE_MODEL=
# Optional exact repository verification catalog. Run it only with the
# agent-verification Compose override, which mounts a private 0600 JSON file.
# Without a profile, Draft output explicitly says tests were not attested.
AGENT_ADAPTER_VERIFICATION_PROFILES_FILE=
AGENT_ADAPTER_VERIFICATION_PROFILES_HOST_PATH=
AGENT_ADAPTER_ALLOWED_PATHS=
AGENT_ADAPTER_MAX_CHANGED_FILES=100
AGENT_ADAPTER_MAX_DIFF_BYTES=2097152
AGENT_ADAPTER_HEARTBEAT_INTERVAL=30s
# These credentials exist only in the isolated adapter. They must be
# repository-scoped read/write tokens; never copy them to Console/control-api.
AGENT_ADAPTER_GITHUB_TOKEN=
AGENT_ADAPTER_GITLAB_TOKEN=
# Optional adapter-private JSON file mounted by the deployment. Entries are
# scoped to installation_id + provider + API base + repository; do not mount
# this file into the coding executor. Global tokens above are development-only.
AGENT_ADAPTER_CREDENTIALS_FILE=
# Production adapter uses a separate task-bound broker instead of a static
# token file. The broker checks the live attempt/job/installation/repository
# before GitHub token minting or GitLab project-token delivery. GitLab coding
# requires a separate project access token with both api and write_repository
# scopes. Before each delivery, the broker verifies the project's bot identity
# and reads the token's own active state and scopes via GitLab's read-only API.
# An unsupported token-self endpoint fails closed. Keep this secret
# distinct from the runner/adapter callback secret. Use a private network.
AGENT_ADAPTER_CREDENTIAL_BROKER_URL=
AGENT_CREDENTIAL_BROKER_SECRET=
AGENT_CREDENTIAL_BROKER_WORKER_ID=
# A separate coding App is recommended to keep review credentials read-only.
# To reuse the review App instead, grant and accept Contents:write on its
# installation; everyone holding that App key can then request write tokens.
# Limit installation access to intended repositories. Each exact tenant/review
# installation/repository maps to a coding installation in a private 0600 JSON
# file; the broker re-reads it before every issuance.
AGENT_CODING_GITHUB_APP_ID=
AGENT_CODING_GITHUB_PRIVATE_KEY_HOST_PATH=
AGENT_CODING_GITHUB_INSTALLATIONS_HOST_PATH=
AGENT_CODING_GITHUB_API_URL=https://api.github.com
# Optional GitLab-only or mixed-provider coding broker. This is a separate
# deployment-owned 0600 map, not the review OAuth token or the adapter file.
# Each entry binds installation_id + provider=gitlab + exact API base +
# repository to a coding token and same-origin clone base. Rotate the file
# atomically; the broker re-reads it for every issued task credential.
AGENT_CODING_GITLAB_CREDENTIALS_HOST_PATH=
# Only for a disposable self-managed GitLab in development.
AGENT_CODING_GITLAB_ALLOW_HTTP=false
# The private mapping file must be owned by this host UID (65532 by default).
AGENT_CREDENTIAL_BROKER_UID=65532
# Production broker requires TLS. Mount the certificate and key into the
# broker container at these paths in your deployment manifest.
AGENT_CREDENTIAL_BROKER_TLS_CERT=
AGENT_CREDENTIAL_BROKER_TLS_KEY=
AGENT_ADAPTER_GITHUB_CLONE_BASE_URL=https://github.com
AGENT_ADAPTER_GITLAB_CLONE_BASE_URL=
# GitHub.com PR links are derived from api.github.com automatically. A GitHub
# Enterprise deployment with a different browser host may set this exact pair.
AGENT_GITHUB_PUBLIC_BASE_URL=
AGENT_GITHUB_PUBLIC_FOR_API_BASE_URL=
# Optional deployment-owned browser origin for self-managed GitLab Draft MRs.
# The adapter validates the exact admitted repository/MR before translating an
# internal provider URL. Production requires HTTPS; local development may use
# loopback HTTP. Set the same value on control-api and the isolated adapter.
AGENT_GITLAB_PUBLIC_BASE_URL=
# Pair the public base with one exact internal API base. Other installed GitLab
# instances are never remapped through this deployment's public URL.
AGENT_GITLAB_PUBLIC_FOR_API_BASE_URL=
# Disposable local GitLab CE only. Must also set ENVIRONMENT=development;
# clone origin must exactly match the admitted GitLab API origin.
AGENT_ADAPTER_GITLAB_ALLOW_HTTP=false
# Reconciles Issue suppression when an approved rule exception expires. This
# worker only restores the linked Issue state and audit timeline; it does not
# alter immutable rule versions or call a provider.
RULE_EXCEPTION_EXPIRER_WORKER_ID=rule-exception-expirer-1
RULE_EXCEPTION_EXPIRER_POLL_INTERVAL=30s
RULE_EXCEPTION_EXPIRER_TENANT_LIMIT=100
RULE_ROLLOUT_MONITOR_WORKER_ID=rule-rollout-monitor-1
RULE_ROLLOUT_MONITOR_POLL_INTERVAL=30s
# Provider probes are read-only. Private/self-managed endpoints require an
# explicit opt-in; plaintext HTTP is development-only.
PROVIDER_PROBE_INTERVAL=5m
PROVIDER_PROBE_POLL_INTERVAL=5s
PROVIDER_PROBE_ALLOW_PRIVATE_NETWORKS=false
PROVIDER_PROBE_ALLOW_HTTP=false
PROVIDER_CHECKS_WORKER_ID=provider-checks-worker-1
PROVIDER_CHECKS_POLL_INTERVAL=5m
PROVIDER_CHECKS_WORKER_INTERVAL=5s
# Restrict these to explicitly isolated development or self-hosted providers.
PROVIDER_CHECKS_ALLOW_PRIVATE_NETWORKS=false
PROVIDER_CHECKS_ALLOW_HTTP=false
# GitHub Apps have no Reaction webhook event. This private worker reconciles
# thumbs feedback on marker-keyed Issue analysis comments for up to 30 days.
PROVIDER_FEEDBACK_POLL_INTERVAL=5m
PROVIDER_FEEDBACK_WORKER_INTERVAL=5s
# Model probes are explicit, fixed four-token provider requests started by a
# workspace administrator. Public endpoints are required by default; set this
# only for an intentionally reachable self-managed model gateway.
MODEL_PROBE_POLL_INTERVAL=2s
MODEL_PROBE_ALLOW_PRIVATE_NETWORKS=false
GITHUB_TOKEN=
# Set true on control-api only when the provider-call workers receive the
# deployment-owned GITLAB_TOKEN. This is a non-secret capability flag; do not
# place the token itself on Console or control-api.
GITLAB_DEPLOYMENT_TOKEN_CONFIGURED=false
GITLAB_TOKEN=

# notifier: each console destination references one of these variables as
# env:NAME. The value may be a plain HTTPS webhook URL, or JSON containing a
# webhook_url and optional signing_secret. The base Compose service forwards
# these deployment-owned slots only to notifier. Compact development mode
# passes them only to its notifier child, but a shared container/UID is not a
# production credential boundary. Routes can send different
# repositories and severities to different slots. Never commit real robot
# credentials. To use another name, add it explicitly to notifier.environment.
OPENREVIEW_NOTIFY_PLATFORM={"webhook_url":"https://example.invalid/replace-me","signing_secret":"replace-me"}
OPENREVIEW_NOTIFY_ENGINEERING=
OPENREVIEW_NOTIFY_SECURITY=
OPENREVIEW_NOTIFY_INCIDENTS=
OPENREVIEW_NOTIFY_RELEASES=
OPENREVIEW_NOTIFY_PRODUCT=

# runner only: OpenCodeReview needs a model route to produce findings.
# Use a secret manager for OCR_LLM_TOKEN in non-development environments.
OCR_LLM_URL=
OCR_LLM_TOKEN=
OCR_LLM_MODEL=
# Required when OCR_LLM_URL points at an OpenAI-compatible Chat Completions
# gateway. Set true only for a gateway that implements Anthropic /v1/messages.
OCR_USE_ANTHROPIC=false
# Optional self-hosted BYOK secret referenced from Models & BYOK as
# env://OPEN_REVIEW_MODEL_SECRET_PRIMARY. The base Compose service forwards it
# only to runner and model-prober; add another named model secret only to those
# two service blocks. Never store this value in the control-plane database or
# browser configuration.
OPEN_REVIEW_MODEL_SECRET_PRIMARY=

# Data governance export artifacts are encrypted with AES-256-GCM before they
# enter PostgreSQL. Generate once with `openssl rand -base64 32`, store it in a
# secret manager, and mount the same value into control-api and the governance
# worker. Losing or rotating this value without a key ring makes old exports
# intentionally unreadable.
DATA_GOVERNANCE_ARTIFACT_KEY=
DATA_GOVERNANCE_ARTIFACT_TTL=24h
DATA_GOVERNANCE_EXPORT_MAX_RECORDS=10000
# Optional deployment-owned region orchestrator. Requests and responses use an
# HMAC-SHA256 signature. The orchestrator must make job_id idempotent and return
# observed infrastructure evidence before Open Review changes residency state.
DATA_GOVERNANCE_REGION_ORCHESTRATOR_URL=
DATA_GOVERNANCE_REGION_ORCHESTRATOR_SECRET=
DATA_GOVERNANCE_REGION_ORCHESTRATOR_ALLOW_PRIVATE=false
# Keep false except for a trusted private-network development orchestrator.
DATA_GOVERNANCE_REGION_ORCHESTRATOR_ALLOW_HTTP=false
DATA_GOVERNANCE_REGION_ORCHESTRATOR_TIMEOUT=20s
DATA_GOVERNANCE_REGION_POLL_INTERVAL=30s
