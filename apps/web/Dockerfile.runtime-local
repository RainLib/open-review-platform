# Package an already verified host-side Next.js standalone build without
# rebuilding dependencies inside the Docker VM. This is a local deployment
# shortcut; a CI release should still build the artifact for its target OS.
#
# docker build -f apps/web/Dockerfile.runtime-local \
#   --build-context next-standalone=apps/web/.next/standalone \
#   --build-context next-static=apps/web/.next/static \
#   -t open-review-platform-console:local-runtime apps/web
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=next-standalone --chown=nextjs:nodejs / ./
COPY --from=next-static --chown=nextjs:nodejs / ./.next/static/
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "server.js"]
