# Server-side URL of the Open Review Go control plane. Do not expose this as a NEXT_PUBLIC variable.
CONTROL_API_URL=http://control-api:8080

# Local development only. The current control plane development authenticator requires this header.
CONTROL_API_DEVELOPMENT_SUBJECT=local-console-admin

# Explicitly opt in to fixture data for UI review. Defaults to false.
OPEN_REVIEW_CONSOLE_DEMO=false
