# Server-side URL of the Open Review Go control plane. Do not expose this as a NEXT_PUBLIC variable.
CONTROL_API_URL=http://control-api:8080

# Local development only. The current control plane development authenticator requires this header.
CONTROL_API_DEVELOPMENT_SUBJECT=local-console-admin

# Explicitly opt in to fixture data for UI review. Defaults to false.
OPEN_REVIEW_CONSOLE_DEMO=false
# Optional fixture-only setup state. Leave unset (or use "ready") to inspect
# Console screens; use needs_connection, verifying_connection,
# connection_failed, needs_setup, or unavailable to exercise the setup gate.
# Never set this as a production control-plane decision.
OPEN_REVIEW_CONSOLE_DEMO_SETUP_STATE=

# Production browser sign-in. Register this exact callback with the Casdoor
# application: https://review.example.com/api/auth/callback. CASDOOR_CLIENT_ID
# defaults to CASDOOR_AUDIENCE when omitted, which is useful when the control
# plane and browser use the same OIDC client.
OPEN_REVIEW_APP_URL=https://review.example.com
# Optional public /v1 API origin for copyable CLI instructions. If unset,
# OPEN_REVIEW_APP_URL is used. Never set this to a private Docker service URL.
OPEN_REVIEW_PUBLIC_API_URL=
CASDOOR_ISSUER=https://casdoor.example.com
CASDOOR_CLIENT_ID=open-review-platform
CASDOOR_CLIENT_SECRET=

# Browser-visible labels for the fixed deployment boundary shown while a
# workspace is created. These do not select an infrastructure region or change
# identity settings; set them from the actual deployment configuration.
OPEN_REVIEW_DEPLOYMENT_MODE=self_hosted
OPEN_REVIEW_DEPLOYMENT_REGION=ap-southeast-1

# GitHub App installation page. Set the App's setup URL to
# https://review.example.com/api/setup/github/complete and register the exact
# OAuth redirect URI https://review.example.com/api/setup/github/authorize/complete.
# The setup callback starts a server-side GitHub user authorization and only
# binds an installation after that user can enumerate it. This prevents a
# spoofed installation_id from becoming a workspace connection.
GITHUB_APP_INSTALL_URL=
GITHUB_APP_ID=
OPEN_REVIEW_GITHUB_INSTALL_STATE_SECRET=
# Generate a GitHub App client secret and store it only in the Console runtime
# secret manager. The browser never receives it or the resulting short-lived
# user token. GITHUB_OAUTH_CLIENT_* and GITHUB_APP_CLIENT_* remain accepted
# aliases for existing deployments.
WEB_OAUTH_GITHUB_CLIENT_ID=
WEB_OAUTH_GITHUB_CLIENT_SECRET=
# Optional GitHub Enterprise Server web base URL. Default: https://github.com.
GITHUB_OAUTH_BASE_URL=https://github.com
# GitHub REST API origin used to confirm the signed-in user's installation.
# GitHub Enterprise Server commonly uses https://github.example/api/v3.
GITHUB_API_URL=https://api.github.com
# The control-api must receive the same value to verify the signed receipt that
# this Console BFF forwards while creating an installation.
OPEN_REVIEW_PROVIDER_AUTH_STATE_SECRET=
# Optional stable 32+ character key used only to derive opaque,
# per-workspace-and-scope GitLab installation IDs. Set before rotating the
# authorization-state secret.
OPEN_REVIEW_GITLAB_INSTALLATION_IDENTITY_SECRET=
GITLAB_API_URL=https://gitlab.com/api/v4
# Optional HTTPS base for self-managed GitLab, including a relative URL path
# when applicable (for example https://gitlab.internal.example/gitlab).
GITLAB_OAUTH_BASE_URL=
# Optional trusted private endpoint for server-side exchange and identity reads.
# Browser authorization redirects always continue to use GITLAB_OAUTH_BASE_URL.
GITLAB_OAUTH_INTERNAL_BASE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_SCOPES=api read_user
