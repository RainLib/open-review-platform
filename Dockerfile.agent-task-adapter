FROM golang:1.25.14-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/agent-task-adapter ./cmd/agent-task-adapter

# This image intentionally includes Git but not an unpinned coding CLI. Build
# one reviewed derivative with a pinned executor and immutable sandbox image.
FROM alpine:3.22 AS adapter-base
RUN apk add --no-cache ca-certificates git docker-cli \
    && adduser -D -H -u 10001 app \
    && for id in 10002 10003 10004 10005 10006 10007 10008 10009; do adduser -D -H -u "$id" "executor$id"; done \
    && mkdir -p /state /workspaces \
    && chmod 0700 /state \
    && chmod 0711 /workspaces
COPY --from=build /out/agent-task-adapter /app/agent-task-adapter
# Adapter-only root identity owns the scoped provider credential file and
# lease receipts. Coding CLIs are always launched as a distinct leased UID.
USER 0:0
ENTRYPOINT ["/app/agent-task-adapter"]

# Opt-in local acceptance image. Pin the coding CLI rather than downloading
# "latest" when a reviewed Agent task starts. This image is still the
# development UID-pool adapter, not the missing per-job production sandbox.
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS codex-cli
RUN npm install -g --ignore-scripts --no-audit --no-fund @openai/codex@0.142.1 \
    && test "$(codex --version)" = "codex-cli 0.142.1"

FROM adapter-base AS adapter-codex
RUN apk add --no-cache libstdc++
COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /usr/local/lib/node_modules/@openai /usr/local/lib/node_modules/@openai
RUN ln -s ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && test "$(codex --version)" = "codex-cli 0.142.1"

# Claude Code is a separately pinned execution profile. Its native package is
# installed in the build stage only; the running child has no npm or outbound
# registry route and receives no upstream model credential.
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS claude-cli
RUN npm install -g --no-audit --no-fund @anthropic-ai/claude-code@2.1.144 \
    && test "$(claude --version)" = "2.1.144 (Claude Code)"

FROM adapter-base AS adapter-claude
RUN apk add --no-cache libstdc++
COPY --from=claude-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=claude-cli /usr/local/bin/claude /usr/local/bin/claude
COPY --from=claude-cli /usr/local/lib/node_modules/@anthropic-ai /usr/local/lib/node_modules/@anthropic-ai
RUN test "$(claude --version)" = "2.1.144 (Claude Code)"

# Immutable per-job sandbox image. It contains no adapter binary, provider
# credential, Docker socket, or model upstream key. The trusted adapter runs
# this image by its locally verified sha256 image ID on an internal network.
FROM alpine:3.22 AS agent-sandbox-codex
RUN apk add --no-cache ca-certificates git libstdc++ \
    && for id in 10002 10003 10004 10005 10006 10007 10008 10009; do adduser -D -H -u "$id" "executor$id"; done
COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /usr/local/lib/node_modules/@openai /usr/local/lib/node_modules/@openai
RUN ln -s ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && test "$(codex --version)" = "codex-cli 0.142.1"
# A child is assigned a leased UID at runtime; default non-root also protects
# accidental direct launches of this image outside the adapter.
USER 10002:10002
ENTRYPOINT []

FROM alpine:3.22 AS agent-sandbox-claude
RUN apk add --no-cache bash ca-certificates git libstdc++ \
    && for id in 10002 10003 10004 10005 10006 10007 10008 10009; do adduser -D -H -u "$id" "executor$id"; done
COPY --from=claude-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=claude-cli /usr/local/bin/claude /usr/local/bin/claude
COPY --from=claude-cli /usr/local/lib/node_modules/@anthropic-ai /usr/local/lib/node_modules/@anthropic-ai
RUN test "$(claude --version)" = "2.1.144 (Claude Code)"
USER 10002:10002
ENTRYPOINT []
