# Build only the Issue analysis worker for the lean review profile. The full
# deployment may continue using the shared core image from Dockerfile.
FROM golang:1.25.14-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/issue-triager ./cmd/issue-triager
COPY internal ./internal
RUN --mount=type=cache,id=open-review-go-build-cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/issue-triager ./cmd/issue-triager

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/issue-triager /app/issue-triager
ENTRYPOINT ["/app/issue-triager"]
